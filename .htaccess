# ClockHub - Apache config (ignored by Netlify / Vercel / GitHub Pages)
ErrorDocument 404 /404.html

# Force HTTPS and a single canonical hostname (non-www)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://clock-hub.com/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.clock-hub\.com [NC]
  RewriteRule ^(.*)$ https://clock-hub.com/$1 [R=301,L]
</IfModule>

# Cache static assets for a year, HTML not at all
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
